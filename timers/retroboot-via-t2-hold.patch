+/*
+ * RetroBoot: when the vCPU translates guest code
+ * (emulator/reports/viacal-20261013.md).
+ *
+ * Guest time follows the host clock, so code that runs for the first time is
+ * one to two orders of magnitude slower in guest time than the same code
+ * later: TCG translates it block by block on the spot.  A device can ask
+ * whether the vCPU is in such a stretch.
+ *
+ * cpu_translation_watch() switches the bookkeeping on, with one vCPU under
+ * TCG without icount only (it returns false otherwise).
+ * cpu_translation_begin()/end() bracket a translation (end is also called
+ * when a translation is abandoned by a longjmp).  cpu_translation_quiet_ns()
+ * is how long, in QEMU_CLOCK_VIRTUAL ns up to @now, the vCPU has not
+ * translated: 0 during a translation, INT64_MAX when not watching.
+ */
+bool cpu_translation_watch(void);
+void cpu_translation_begin(void);
+void cpu_translation_end(void);
+int64_t cpu_translation_quiet_ns(int64_t now);
+
 #endif /* SYSTEM_CPU_TIMERS_H */
diff --git a/system/cpu-timers.c b/system/cpu-timers.c
--- a/system/cpu-timers.c
+++ b/system/cpu-timers.c
@@ -37,6 +37,7 @@
 #include "system/cpu-timers.h"
 #include "system/cpu-timers-internal.h"
 #include "exec/icount.h"
+#include "system/tcg.h"
 
 /* clock and ticks */
 
@@ -284,8 +285,75 @@ void qemu_timer_notify_cb(void *opaque, QEMUClockType type)
 TimersState timers_state;
 
 /* initialize timers state and the cpu throttle for convenience */
+/*
+ * RetroBoot: when the vCPU translates (see include/system/cpu-timers.h).
+ * The only writer is the vCPU thread (one vCPU); readers use the seqlock.
+ */
+static struct {
+    bool enabled;
+    QemuSeqLock seq;
+    int64_t start;              /* current translation's start, 0 = none */
+    int64_t last_end;           /* end of the last one */
+} xlate;
+
+bool cpu_translation_watch(void)
+{
+    if (!tcg_enabled() || icount_enabled() || qemu_get_cpu(1)) {
+        return false;
+    }
+    qatomic_store_release(&xlate.enabled, true);
+    return true;
+}
+
+void cpu_translation_begin(void)
+{
+    int64_t now;
+
+    if (!qatomic_load_acquire(&xlate.enabled)) {
+        return;
+    }
+    now = MAX(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), 1);
+    seqlock_write_begin(&xlate.seq);
+    xlate.start = now;
+    seqlock_write_end(&xlate.seq);
+}
+
+void cpu_translation_end(void)
+{
+    int64_t now;
+
+    if (!xlate.start) {         /* written by this thread only */
+        return;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    seqlock_write_begin(&xlate.seq);
+    xlate.last_end = now;
+    xlate.start = 0;
+    seqlock_write_end(&xlate.seq);
+}
+
+int64_t cpu_translation_quiet_ns(int64_t now)
+{
+    int64_t start, last_end;
+    unsigned v;
+
+    if (!qatomic_load_acquire(&xlate.enabled)) {
+        return INT64_MAX;
+    }
+    do {
+        v = seqlock_read_begin(&xlate.seq);
+        start = xlate.start;
+        last_end = xlate.last_end;
+    } while (seqlock_read_retry(&xlate.seq, v));
+    if (start) {
+        return 0;
+    }
+    return now > last_end ? now - last_end : 0;
+}
+
 void cpu_timers_init(void)
 {
+    seqlock_init(&xlate.seq);
     seqlock_init(&timers_state.vm_clock_seqlock);
     qemu_spin_init(&timers_state.vm_clock_lock);
     vmstate_register(NULL, 0, &vmstate_timers, &timers_state);
