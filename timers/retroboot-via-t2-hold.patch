+/*
+ * RetroBoot (t2_hold): should a timer-2 interrupt that is due now wait?
+ *
+ * At startup the Mac OS ROM times four loops against timer 2: it loads 1 ms,
+ * enables the interrupt and counts a loop of at most 65536 iterations; the
+ * level-1 handler discards its frame and jumps to the code after the loop,
+ * which stores the count and moves a table pointer on to the next loop,
+ * whose first instructions load timer 2 again.  A loop that runs out before
+ * the interrupt is stored as 0xFFFF.  An interrupt that arrives in the dozen
+ * instructions between the table pointer's advance and that load makes the
+ * handler run the store a second time with the pointer already advanced:
+ * the ROM writes 0xFFFF over the vector at 0x1C and jumps into the middle of
+ * unrelated ROM code, ending in the nanokernel's debugger (pre-gray hang
+ * type B).  On hardware those instructions take about a microsecond.  Under
+ * TCG they run for the first time when the first loop runs out and are
+ * translated block by block (14 blocks, 0.15 ms on the lab builder, three
+ * times that on an N5105), and guest time follows the host clock, so a
+ * deadline a little after the end of the loop lands among them.  r17's
+ * faster branches made the first loop (65536 DBRAs) run out just before the
+ * 1 ms deadline on slower hosts.
+ *
+ * So, while timer 2's interrupt is enabled, an interrupt that falls due
+ * while the vCPU is translating waits until the vCPU has not translated for
+ * t2_hold_quiet_us (hot code: a timing loop), at most t2_hold_max_us.  A
+ * loop that is still running takes its interrupt as before; one that has
+ * run out reaches the next load of timer 2, which cancels the interrupt as
+ * on hardware.  The counter and the timebase keep host time.
+ */
+static bool mos6522_t2_hold(MOS6522State *s, int64_t now)
+{
+    int64_t quiet;
+
+    if (!s->t2_hold || !(s->ier & T2_INT)) {
+        return false;
+    }
+    if (!s->t2_held_since) {
+        s->t2_held_since = now;
+    }
+    if (now - s->t2_held_since >= (int64_t)s->t2_hold_max_us * SCALE_US) {
+        return false;
+    }
+    quiet = cpu_translation_quiet_ns(now);
+    if (quiet >= (int64_t)s->t2_hold_quiet_us * SCALE_US) {
+        return false;
+    }
+    /* look again when the vCPU could have been quiet long enough */
+    timer_mod(s->timers[1].timer,
+              now + (int64_t)s->t2_hold_quiet_us * SCALE_US - quiet);
+    return true;
+}
+
 static void mos6522_timer2(void *opaque)
 {
     MOS6522State *s = opaque;
     MOS6522Timer *ti = &s->timers[1];
 
+    if (s->coherent_timers &&
+        mos6522_t2_hold(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL))) {
+        return;
+    }
+
     mos6522_timer2_fired(s);
     mos6522_timer2_update(s, ti, ti->next_irq_time);
     s->ifr |= T2_INT;
