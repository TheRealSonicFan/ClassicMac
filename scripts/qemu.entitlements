<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- QEMU's TCG uses a just-in-time translator; under the hardened runtime
	     it needs the JIT entitlement to map writable/executable memory on
	     both Apple Silicon (arm64) and Intel (x86_64) Macs. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Allow the emulator to load the bundled dynamic libraries, which are
	     signed with the same identity but carry Homebrew team IDs upstream. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
