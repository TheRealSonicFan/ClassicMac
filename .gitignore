# Reference material (large copyrighted ROM set + OS install media)
context/

# Disk images and optical media
*.iso
*.img
*.dmg
*.qcow2
# ...but keep the committed PRAM seed template
!shared/pram-seed.img

# QEMU source checkout + build artifacts (vendor-<arch>/ for per-architecture
# trees, see README "Intel Macs and universal builds")
vendor/
vendor-*/
build/

# Built application bundle
*.app/
dist/
dist-*/

# Xcode / SwiftPM
DerivedData/
.build/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
.swiftpm/

# macOS
.DS_Store

# Editor
*.swp

# Local Python/test harness artifacts
__pycache__/
tools/os9-install-harness/shots/

# Contained parallel checkouts and local integration artifacts
worktrees/
artifacts/
output/
scratch/
tmp/

# Windows desktop dependencies
node_modules/
