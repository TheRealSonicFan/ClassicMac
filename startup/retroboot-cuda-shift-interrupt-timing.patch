+/*
+ * Shift interrupt timing (RetroBoot).  Cuda raises the VIA shift interrupt
+ * sr_delay_ns after each handshake step.  QEMU's main loop runs that timer,
+ * and on a loaded host it can run milliseconds late while the vCPU polls IFR
+ * (the Mac OS ROM gives up after 15000 polls).  A shift interrupt that is
+ * due is therefore delivered when the guest reads the VIA, as mos6522_read()
+ * already does for the VIA's own timers.
+ *
+ * Sync handshake (RetroBoot).  Before its first command the Mac OS ROM
+ * synchronises with Cuda, polled and with VIA interrupts disabled: with TIP
+ * negated it asserts TACK, waits for TREQ and the shift interrupt, then
+ * negates TACK, waits for TREQ to follow, *reads SR to discard the previous
+ * byte* and only then waits (15000 polls) for the shift interrupt of this
+ * step.  If that interrupt never comes the ROM gives up and halts in a loop
+ * before the Mac OS gray screen ("Cuda not responding").
+ *
+ * Real Cuda changes TREQ first and clocks the byte out afterwards, so the
+ * host always sees TREQ change, and reads SR, before the shift completes.
+ * QEMU changes TREQ at once and completes the shift sr_delay_ns of *host*
+ * time later.  When the vCPU needs longer than that from its TACK write to
+ * its SR read (the host descheduled the vCPU thread, TCG translates this
+ * run-once code, tracing), the shift interrupt is already pending at the SR
+ * read, the read discards it, and the boot hangs (a few percent of cold
+ * boots on a loaded host, 1 of 6 on real hardware; lab report
+ * emulator/reports/pregray-hang-20261011.md).
+ *
+ * So the shift interrupt that answers a sync step survives the first SR
+ * read that comes before the host has seen it in IFR.  Hosts that wait for
+ * the interrupt before reading SR (Linux, the ROM's first step and every
+ * transfer) never notice; the ROM's second step now gets its interrupt
+ * whatever the host's timing.  sr-int-on-access=off and sync-sr-hold=off
+ * restore QEMU's behaviour.
+ */
 static uint64_t mos6522_cuda_read(void *opaque, hwaddr addr, unsigned size)
 {
     CUDAState *s = opaque;
     MOS6522CUDAState *mcs = &s->mos6522_cuda;
     MOS6522State *ms = MOS6522(mcs);
+    uint64_t val;
 
     addr = (addr >> 9) & 0xf;
-    return mos6522_read(ms, addr, size);
+    if (s->sr_int_on_access && timer_pending(s->sr_delay_timer)) {
+        int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        int64_t due = timer_expire_time_ns(s->sr_delay_timer);
+
+        if (now >= due) {
+            timer_del(s->sr_delay_timer);
+            trace_cuda_sr_int_due(now - due);
+            cuda_set_sr_int(s);
+        }
+    }
+    val = mos6522_read(ms, addr, size);
+    if (s->sync_sr_unseen) {
+        if (addr == VIA_REG_IFR && (val & SR_INT)) {
+            s->sync_sr_unseen = false;
+        } else if (addr == VIA_REG_SR) {
+            s->sync_sr_unseen = false;
+            trace_cuda_sync_sr_kept();
+            qemu_set_irq(qdev_get_gpio_in(DEVICE(ms), SR_INT_BIT), 1);
+        }
+    }
+    return val;
 }
 
 static void mos6522_cuda_write(void *opaque, hwaddr addr, uint64_t val,
@@ -519,6 +582,9 @@ static void mos6522_cuda_write(void *opaque, hwaddr addr, uint64_t val,
     MOS6522State *ms = MOS6522(mcs);
 
     addr = (addr >> 9) & 0xf;
+    if (addr == VIA_REG_IFR && (val & SR_INT)) {
+        s->sync_sr_unseen = false;
+    }
     mos6522_write(ms, addr, val, size);
 }
 
