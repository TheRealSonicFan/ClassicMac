diff --git a/hw/ide/macio.c b/hw/ide/macio.c
--- a/hw/ide/macio.c
+++ b/hw/ide/macio.c
@@ -363,6 +363,25 @@ static void pmac_ide_flush(DBDMA_io *io)
     pmac_ide_drain(io->opaque);
 }
 
+/*
+ * srst-complete-on-access (RetroBoot, default on): QEMU carries out an ATA
+ * software reset (SRST) in a main-loop bottom half.  On a busy host that
+ * runs milliseconds after the guest has released SRST.  OpenBIOS probes the
+ * absent slave meanwhile (its status reads 0, never busy, so OpenBIOS does
+ * not wait), the master's reset then lands in the middle of the probe, the
+ * hard disk is not found, "boot" fails silently and OpenBIOS waits at its
+ * prompt with the screen black (pre-gray hang, about 1 % of cold boots on
+ * a loaded host; emulator/reports/pregray-hang-20261011.md).  A real drive
+ * has finished its reset long before then.  So a pending reset is carried
+ * out on the guest's next access to the controller.
+ */
+static void pmac_ide_srst_complete(MACIOIDEState *d)
+{
+    if (d->srst_complete_on_access) {
+        ide_bus_srst_complete(&d->bus);
+    }
+}
+
 /* PowerMac IDE memory IO */
 static uint64_t pmac_ide_read(void *opaque, hwaddr addr, unsigned size)
 {
@@ -370,6 +389,7 @@ static uint64_t pmac_ide_read(void *opaque, hwaddr addr, unsigned size)
     uint64_t retval = 0xffffffff;
     int reg = addr >> 4;
 
+    pmac_ide_srst_complete(d);
     switch (reg) {
     case 0x0:
         if (size == 1) {
@@ -420,6 +440,8 @@ static void pmac_ide_write(void *opaque, hwaddr addr, uint64_t val,
     MACIOIDEState *d = opaque;
     int reg = addr >> 4;
 
+    pmac_ide_srst_complete(d);
+
     switch (reg) {
     case 0x0:
         if (size == 2) {
@@ -625,6 +647,8 @@ static const Property macio_ide_properties[] = {
     DEFINE_PROP_UINT64("dma-completion-delay-ns", MACIOIDEState,
                        dma_completion_delay_ns,
                        MACIO_IDE_DEFAULT_COMPLETION_DELAY_NS),
+    DEFINE_PROP_BOOL("srst-complete-on-access", MACIOIDEState,
+                     srst_complete_on_access, true),
 };
 
