diff --git a/hw/ide/core.c b/hw/ide/core.c
--- a/hw/ide/core.c
+++ b/hw/ide/core.c
@@ -2335,6 +2335,10 @@ static void ide_bus_perform_srst(void *opaque)
     IDEState *s;
     int i;
 
+    if (!bus->srst_pending) {
+        return;     /* already carried out by ide_bus_srst_complete() */
+    }
+    bus->srst_pending = false;
     for (i = 0; i < 2; i++) {
         s = &bus->ifs[i];
         ide_perform_srst(s);
@@ -2343,6 +2347,19 @@ static void ide_bus_perform_srst(void *opaque)
     bus->cmd &= ~IDE_CTRL_RESET;
 }
 
+/*
+ * RetroBoot: carry out a pending software reset now, once the guest has
+ * released SRST and no DMA is in flight (then the bottom half does it, as
+ * before).  See pmac_ide_srst_complete() in hw/ide/macio.c.
+ */
+void ide_bus_srst_complete(IDEBus *bus)
+{
+    if (bus->srst_pending && !(bus->cmd & IDE_CTRL_RESET) &&
+        !(bus->dma && bus->dma->aiocb)) {
+        ide_bus_perform_srst(bus);
+    }
+}
