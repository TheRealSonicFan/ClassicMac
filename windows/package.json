{
  "name": "classicmac-desktop",
  "version": "4.0.0",
  "description": "ClassicMac for Windows",
  "author": "Austin McChord",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "electron-builder --win zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.classicmac.emulator.windows",
    "productName": "ClassicMac",
    "directories": {
      "output": "../output/windows/packages"
    },
    "files": [
      "src/**",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../output/windows/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "icon": "ui/app.ico"
    },
    "artifactName": "ClassicMac-${version}-Windows-${arch}.${ext}"
  }
}
