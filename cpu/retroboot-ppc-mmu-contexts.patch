+void tlb_flush_page_class_by_mmuidx(CPUState *cpu, vaddr addr, vaddr mask,
+                                    MMUIdxMap idxmap)
+{
+    CPUJumpCache *jc = cpu->tb_jmp_cache;
+    MMUIdxMap work;
+    size_t i;
+
+    assert_cpu_is_self(cpu);
+    tlb_debug("class %016" VADDR_PRIx "/%016" VADDR_PRIx " mmu_idx:%" PRIx16 "\n",
+              addr, mask, idxmap);
+
+    mask &= TARGET_PAGE_MASK;
+    addr &= mask;
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    /* an index without entries since its last full flush has none to drop */
+    for (work = idxmap & cpu->neg.tlb.c.dirty; work; work &= work - 1) {
+        int midx = ctz32(work);
+        CPUTLBDescFast *f = cpu_tlb_fast(cpu, midx);
+        size_t n = tlb_n_entries(f);
+
+        for (i = 0; i < n; i++) {
+            /* TLB_INVALID_MASK in the mask: empty entries never match */
+            if (tlb_flush_entry_mask_locked(&f->table[i], addr,
+                                            mask | TLB_INVALID_MASK)) {
+                tlb_n_used_entries_dec(cpu, midx);
+            }
+        }
+        tlb_flush_vtlb_page_mask_locked(cpu, midx, addr,
+                                        mask | TLB_INVALID_MASK);
+    }
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+
+    if (jc) {
+        for (i = 0; i < TB_JMP_CACHE_SIZE; i++) {
+            if ((qatomic_read(&jc->array[i].pc) & mask) == addr) {
+                qatomic_set(&jc->array[i].tb, NULL);
+            }
+        }
+    }
+}
+
 void tlb_flush_page(CPUState *cpu, vaddr addr)
 {
     tlb_flush_page_by_mmuidx(cpu, addr, ALL_MMUIDX_BITS);
