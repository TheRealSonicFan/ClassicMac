+/*****************************************************************************/
+/* 32-bit hash MMU translation contexts */
+
+static MMUIdxMap ppc_tlb_ctx_idxmap(unsigned ctx)
+{
+    return 3u << (4 * ctx);
+}
+
+static void ppc_tlb_ctx_key(CPUPPCState *env, target_ulong *key)
+{
+    memcpy(key, env->sr, 16 * sizeof(target_ulong));
+    memcpy(key + 16, env->IBAT, sizeof(env->IBAT));
+    memcpy(key + 16 + 16, env->DBAT, sizeof(env->DBAT));
+    key[PPC_TLB_CTX_KEY - 1] = env->spr[SPR_SDR1];
+}
+
+/* Forget every context; the caller flushes the TLB (reset, migration). */
+void ppc_tlb_ctx_reset(CPUPPCState *env)
+{
+    PowerPCCPU *cpu = env_archcpu(env);
+
+    QEMU_BUILD_BUG_ON(4 * (PPC_TLB_CTX_N - 1) + 1 >= NB_MMU_MODES);
+    QEMU_BUILD_BUG_ON(sizeof(env->IBAT) != 16 * sizeof(target_ulong));
+    env->tlb_ctx_on = cpu->mmu_contexts && env->mmu_model == POWERPC_MMU_32B;
+    env->tlb_ctx = 0;
+    env->tlb_ctx_tick = 0;
+    memset(env->tlb_ctx_valid, 0, sizeof(env->tlb_ctx_valid));
+    memset(env->tlb_ctx_used, 0, sizeof(env->tlb_ctx_used));
+    env->tlb_need_flush &= ~TLB_NEED_CTX_SWITCH;
+}
+
+/*
+ * At a context-synchronising event after an SR or BAT change: continue in
+ * the context that holds the new state, or recycle the least recently used.
+ */
+void ppc_tlb_ctx_switch(CPUPPCState *env)
+{
+    target_ulong key[PPC_TLB_CTX_KEY];
+    unsigned cur = env->tlb_ctx, use = PPC_TLB_CTX_N, c;
+
+    env->tlb_need_flush &= ~TLB_NEED_CTX_SWITCH;
+    ppc_tlb_ctx_key(env, key);
+    if (env->tlb_ctx_valid[cur] && !memcmp(key, env->tlb_ctx_key[cur], sizeof(key))) {
+        return;
+    }
+    for (c = 0; c < PPC_TLB_CTX_N; c++) {
+        if (env->tlb_ctx_valid[c] && !memcmp(key, env->tlb_ctx_key[c], sizeof(key))) {
+            use = c;
+            break;
+        }
+    }
+    if (use == PPC_TLB_CTX_N) {
+        use = 0;
+        for (c = 0; c < PPC_TLB_CTX_N; c++) {
+            if (!env->tlb_ctx_valid[c]) {
+                use = c;
+                break;
+            }
+            if (env->tlb_ctx_used[c] < env->tlb_ctx_used[use]) {
+                use = c;
+            }
+        }
+        /* also clears the jump cache: TBs of this context may be stale */
+        tlb_flush_by_mmuidx(env_cpu(env), ppc_tlb_ctx_idxmap(use));
+        memcpy(env->tlb_ctx_key[use], key, sizeof(key));
+        env->tlb_ctx_valid[use] = true;
+    }
+    env->tlb_ctx_used[use] = ++env->tlb_ctx_tick;
+    if (use != cur) {
+        env->tlb_ctx = use;
+        hreg_compute_hflags(env);
+    }
+}
+
+/* The state changed under translated execution: refill the current context. */
+void ppc_tlb_ctx_restart(CPUPPCState *env)
+{
+    unsigned cur = env->tlb_ctx;
+
+    tlb_flush_by_mmuidx(env_cpu(env), ppc_tlb_ctx_idxmap(cur));
+    ppc_tlb_ctx_key(env, env->tlb_ctx_key[cur]);
+    env->tlb_ctx_valid[cur] = true;
+    env->tlb_need_flush &= ~TLB_NEED_CTX_SWITCH;
+}
+
+/* A BAT register changed (the new value is already stored). */
+static void ppc_tlb_ctx_bat_changed(CPUPPCState *env)
+{
+    if (env->msr & ((1 << MSR_IR) | (1 << MSR_DR))) {
+        ppc_tlb_ctx_restart(env);       /* effective at once, as before */
+    } else {
+        /* real mode does not use BATs: switch at the next sync or mtmsr */
+        env->tlb_need_flush |= TLB_NEED_CTX_SWITCH;
+    }
+}
+
+static void ppc_store_batu(CPUPPCState *env, target_ulong (*bat)[8],
+                           uint32_t nr, target_ulong value)
+{
+    target_ulong mask = (value << 15) & 0x0FFE0000UL;
+
+    bat[0][nr] = (value & 0x00001FFFUL) | (value & ~0x0001FFFFUL & ~mask);
+    bat[1][nr] = (bat[1][nr] & 0x0000007B) | (bat[1][nr] & ~0x0001FFFF & ~mask);
+    ppc_tlb_ctx_bat_changed(env);
+}
