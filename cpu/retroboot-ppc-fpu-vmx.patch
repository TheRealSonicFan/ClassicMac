diff --git a/target/ppc/vmx_fast.c.inc b/target/ppc/vmx_fast.c.inc
new file mode 100644
--- /dev/null
+++ b/target/ppc/vmx_fast.c.inc
@@ -0,0 +1,196 @@
+/*
+ * RetroBoot: fast lanes for AltiVec floating point (fast-fpu, part
+ * PPC_FAST_FPU_VMX, env->fast_vmx).
+ *
+ * AltiVec has no floating-point status: VSCR holds only NJ and SAT, and no
+ * instruction reads env->vec_status's exception flags.  An AltiVec FP
+ * result is therefore a function of the operands and NJ alone, and a lane
+ * may be computed with host single/double arithmetic whenever that gives
+ * the bit pattern softfloat gives.  These functions do so for operands that
+ * are normal numbers or zeros (never NaN, infinity or denormal, so NJ's
+ * input flushing cannot apply) and results that are zero or normal numbers
+ * above FLT_MIN (so NJ's output flushing and tininess cannot apply), and
+ * return false otherwise; the caller then runs the original softfloat code
+ * for that lane.  The only difference is that env->vec_status's exception
+ * flags are not accumulated for fast lanes; nothing reads them (they only
+ * select softfloat's internal hardfloat shortcut, which gives the same
+ * results).
+ */
+
+#include "ff_stats.h"
+
+static inline float fv_f(uint32_t x)
+{
+    float f;
+    memcpy(&f, &x, sizeof(f));
+    return f;
+}
+
+static inline uint32_t fv_u(float f)
+{
+    uint32_t x;
+    memcpy(&x, &f, sizeof(x));
+    return x;
+}
+
+static inline uint64_t fv_u64(double d)
+{
+    uint64_t x;
+    memcpy(&x, &d, sizeof(x));
+    return x;
+}
+
+static inline bool fv_zero(uint32_t x)
+{
+    return !(x & 0x7fffffff);
+}
+
+static inline bool fv_normal(uint32_t x)
+{
+    return ((x >> 23) & 0xff) - 1u < 0xfeu;
+}
+
+static inline bool fv_nz(uint32_t x)
+{
+    return fv_normal(x) || fv_zero(x);
+}
+
+/* result: zero, or normal above FLT_MIN and finite */
+static inline bool fv_res(uint32_t y)
+{
+    uint32_t a = y & 0x7fffffff;
+    return a == 0 || (a > 0x00800000 && a < 0x7f800000);
+}
+
+static inline bool fv_add(uint32_t a, uint32_t b, uint32_t *r)
+{
+    uint32_t y;
+
+    if (!fv_nz(a) || !fv_nz(b)) {
+        return false;
+    }
+    y = fv_u(fv_f(a) + fv_f(b));
+    *r = y;
+    return fv_res(y);       /* a zero sum of two such operands is exact */
+}
+
+static inline bool fv_sub(uint32_t a, uint32_t b, uint32_t *r)
+{
+    uint32_t y;
+
+    if (!fv_nz(a) || !fv_nz(b)) {
+        return false;
+    }
+    y = fv_u(fv_f(a) - fv_f(b));
+    *r = y;
+    return fv_res(y);
+}
+
+/*
+ * a * c + b (or -(a * c - b) for vnmsubfp), fused: the product of two
+ * singles is exact in double, 2Sum gives the exact sum s + err, and
+ * RN24(s) is the fused result unless s is a single-precision midpoint and
+ * err != 0 (s itself is RN53 of the exact sum, which cannot step over a
+ * midpoint).  No host FMA needed.
+ */
+static inline bool fv_madd(uint32_t a, uint32_t c, uint32_t b, bool nmsub,
+                           uint32_t *r)
+{
+    double p, db, s, bb, err;
+    uint64_t rs;
+    uint32_t y;
+
+    if (!fv_nz(a) || !fv_nz(c) || !fv_nz(b)) {
+        return false;
+    }
+    p = (double)fv_f(a) * (double)fv_f(c);
+    db = nmsub ? -(double)fv_f(b) : (double)fv_f(b);
+    s = p + db;
+    bb = s - p;
+    err = (p - (s - bb)) + (db - bb);
+    rs = fv_u64(s);
+    if (err != 0 && ((rs & 0x7fffffffffffffffULL) == 0 ||
+                     (rs & 0x1fffffffULL) == 0x10000000ULL)) {
+        return false;
+    }
+    y = fv_u((float)s);
+    if (!fv_res(y) || (fv_zero(y) && s != 0)) {
+        return false;
+    }
+    *r = nmsub ? y ^ 0x80000000u : y;
+    return true;
+}
+
+static inline bool fv_max(uint32_t a, uint32_t b, uint32_t *r)
+{
+    float fa = fv_f(a), fb = fv_f(b);
+
+    if (!fv_nz(a) || !fv_nz(b)) {
+        return false;
+    }
+    *r = fa > fb ? a : fa < fb ? b : (a & b);   /* max(+0, -0) = +0 */
+    return true;
+}
+
+static inline bool fv_min(uint32_t a, uint32_t b, uint32_t *r)
+{
+    float fa = fv_f(a), fb = fv_f(b);
+
+    if (!fv_nz(a) || !fv_nz(b)) {
+        return false;
+    }
+    *r = fa < fb ? a : fa > fb ? b : (a | b);   /* min(+0, -0) = -0 */
+    return true;
+}
+
+static inline bool fv_re(uint32_t b, uint32_t *r)
+{
+    uint32_t y;
+
+    if (!fv_normal(b)) {
+        return false;
+    }
+    y = fv_u(1.0f / fv_f(b));
+    *r = y;
+    return fv_res(y);
+}
+
+static inline bool fv_rsqrte(uint32_t b, uint32_t *r)
+{
+    uint32_t y;
+
+    if (!fv_normal(b) || (b >> 31)) {
+        return false;
+    }
+    y = fv_u(1.0f / __builtin_sqrtf(fv_f(b)));
+    *r = y;
+    return fv_res(y);
+}
+
+/* ordered compare of two normal-or-zero operands: -1 less, 0 equal, 1 greater */
+static inline bool fv_cmp(uint32_t a, uint32_t b, int *rel)
+{
+    float fa = fv_f(a), fb = fv_f(b);
+
+    if (!fv_nz(a) || !fv_nz(b)) {
+        return false;
+    }
+    *rel = fa < fb ? -1 : fa > fb ? 1 : 0;
+    return true;
+}
+
+/* vctsxs/vctuxs: trunc(b * 2^uim) as int64 for |value| < 2^63 */
+static inline bool fv_cvt(uint32_t b, uint32_t uim, int64_t *j)
+{
+    double t;
+
+    if (!fv_nz(b)) {
+        return false;
+    }
+    t = (double)fv_f(b) * (double)(1ULL << uim);   /* exact */
+    if (!(t < 0x1p63 && t > -0x1p63)) {
+        return false;
+    }
+    *j = (int64_t)t;
+    return true;
+}
