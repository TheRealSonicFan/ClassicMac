+/*
+ * fast-fpu: lfs/stfs convert normal numbers inline and call
+ * helper_todouble/helper_tosingle only for zero, denormal, infinity and NaN
+ * (lfs) or exponents at or below the single range (stfs).
+ */
+static void gen_todouble_inline(TCGv_i64 dest, TCGv_i32 src)
+{
+    TCGLabel *slow = gen_new_label();
+    TCGLabel *done = gen_new_label();
+    TCGv_i32 e = tcg_temp_new_i32();
+    TCGv_i64 t = tcg_temp_new_i64();
+    TCGv_i64 s = tcg_temp_new_i64();
+
+    tcg_gen_extract_i32(e, src, 23, 8);
+    tcg_gen_subi_i32(e, e, 1);
+    tcg_gen_brcondi_i32(TCG_COND_GEU, e, 0xfe, slow);
+    /* normal: exponent + 896, fraction << 29 */
+    tcg_gen_extu_i32_i64(t, src);
+    tcg_gen_andi_i64(s, t, 0x80000000);
+    tcg_gen_andi_i64(t, t, 0x7fffffff);
+    tcg_gen_shli_i64(t, t, 29);
+    tcg_gen_addi_i64(t, t, 896ULL << 52);
+    tcg_gen_shli_i64(s, s, 32);
+    tcg_gen_or_i64(dest, t, s);
+    tcg_gen_br(done);
+    gen_set_label(slow);
+    gen_helper_todouble(dest, src);
+    gen_set_label(done);
+}
+
+static void gen_tosingle_inline(TCGv_i32 dest, TCGv_i64 src)
+{
+    TCGLabel *slow = gen_new_label();
+    TCGLabel *done = gen_new_label();
+    TCGv_i64 e = tcg_temp_new_i64();
+    TCGv_i64 t = tcg_temp_new_i64();
+
+    tcg_gen_extract_i64(e, src, 52, 11);
+    tcg_gen_brcondi_i64(TCG_COND_LEU, e, 896, slow);
+    /* bits 63..62 to 31..30, bits 58..29 to 29..0 */
+    tcg_gen_shri_i64(e, src, 32);
+    tcg_gen_andi_i64(e, e, 0xc0000000);
+    tcg_gen_extract_i64(t, src, 29, 30);
+    tcg_gen_or_i64(e, e, t);
+    tcg_gen_extrl_i64_i32(dest, e);
+    tcg_gen_br(done);
+    gen_set_label(slow);
+    gen_helper_tosingle(dest, src);
+    gen_set_label(done);
+}
