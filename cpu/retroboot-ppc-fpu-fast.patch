diff --git a/target/ppc/ff_stats.h b/target/ppc/ff_stats.h
new file mode 100644
--- /dev/null
+++ b/target/ppc/ff_stats.h
@@ -0,0 +1,49 @@
+/*
+ * RetroBoot fast-fpu: optional hit/fallback counters for lab builds
+ * (configure --extra-cflags=-DPPC_FF_STATS).  Printed to stderr at exit.
+ * Compiled out otherwise.
+ */
+#ifndef PPC_FF_STATS_H
+#define PPC_FF_STATS_H
+
+#ifdef PPC_FF_STATS
+typedef struct FFStat {
+    const char *name;
+    uint64_t hit, miss;
+    struct FFStat *next;
+    bool listed;
+} FFStat;
+
+static FFStat *ff_stat_list;
+
+static void ff_stat_dump(void)
+{
+    for (FFStat *s = ff_stat_list; s; s = s->next) {
+        fprintf(stderr, "ff-stats %-16s fast %12" PRIu64 " fallback %12" PRIu64
+                "\n", s->name, s->hit, s->miss);
+    }
+}
+
+static inline void ff_stat(FFStat *s, bool hit)
+{
+    if (unlikely(!s->listed)) {
+        if (!ff_stat_list) {
+            atexit(ff_stat_dump);
+        }
+        s->listed = true;
+        s->next = ff_stat_list;
+        ff_stat_list = s;
+    }
+    if (hit) {
+        s->hit++;
+    } else {
+        s->miss++;
+    }
+}
+#define FF_STAT(NAME, HIT) \
+    do { static FFStat ff_st_ = { .name = NAME }; ff_stat(&ff_st_, HIT); } while (0)
+#else
+#define FF_STAT(NAME, HIT) do { } while (0)
+#endif
+
+#endif
diff --git a/target/ppc/fpu_fast.c.inc b/target/ppc/fpu_fast.c.inc
new file mode 100644
--- /dev/null
+++ b/target/ppc/fpu_fast.c.inc
@@ -0,0 +1,800 @@
+/*
+ * RetroBoot: fast paths for the PowerPC scalar FPU (-cpu ...,fast-fpu=on).
+ *
+ * QEMU translates every arithmetic FP instruction into four helper calls
+ * (reset_fpstatus, the softfloat operation, compute_fprf_float64,
+ * float_check_status).  With fast-fpu each instruction is one helper that
+ * first tries the host's IEEE arithmetic, and runs exactly the original
+ * sequence whenever it cannot prove that the outcome is the same.
+ *
+ * The fast path is taken only when
+ *   - FPSCR[XE] = 0, so an inexact result never traps, and the rounding
+ *     mode is round-to-nearest-even;
+ *   - no deferred floating-point program exception is pending;
+ *   - the operands are normal numbers or zeros (never NaN, infinity or
+ *     denormal);
+ *   - the result is zero, or a normal number strictly above the smallest
+ *     normal and below overflow, in the precision of the instruction.
+ * Then the only exception condition is "inexact", and it is determined
+ * exactly: error-free transformations for add/subtract (2Sum, which is
+ * exact here since |operands| < 2^1022), an integer test for products and
+ * quotients, and exact 128-bit integer arithmetic for fused multiply-add.
+ * The host must evaluate double precision without excess precision
+ * (FLT_EVAL_METHOD 0) and the C code below never contracts into FMA.
+ *
+ * On the fast path the instruction leaves FPSCR, the softfloat status flags
+ * and the target FPR exactly as the original sequence does: FPRF set from the
+ * result, FI = inexact, XX and FX set when inexact (QEMU sets FX on every
+ * inexact result), FR untouched, nothing else changed.  The fallback writes
+ * the target FPR before float_check_status can raise a deferred exception,
+ * as the original TCG sequence does.
+ */
+
+#include <float.h>
+#include "ff_stats.h"
+
+#if FLT_EVAL_METHOD == 0 && defined(CONFIG_INT128)
+#define FF_ENABLED 1
+#else
+#define FF_ENABLED 0
+#endif
+
+#define FF_SIGN    0x8000000000000000ULL
+#define FF_ABS     0x7fffffffffffffffULL
+#define FF_FRAC    0x000fffffffffffffULL
+#define FF_HIDDEN  0x0010000000000000ULL
+#define FF_MINN    0x0010000000000000ULL    /* 2^-1022 */
+#define FF_INF     0x7ff0000000000000ULL
+#define FF_S_MIN   0x3810000000000000ULL    /* 2^-126 as a double */
+#define FF_S_MAX   0x47efffffe0000000ULL    /* FLT_MAX as a double */
+#define FF_S_LOW   0x1fffffffULL            /* bits below single precision */
+#define FF_S_HALF  0x10000000ULL            /* half an ulp of single */
+
+static inline double ff_d(uint64_t x)
+{
+    double d;
+    memcpy(&d, &x, sizeof(d));
+    return d;
+}
+
+static inline uint64_t ff_u(double d)
+{
+    uint64_t x;
+    memcpy(&x, &d, sizeof(x));
+    return x;
+}
+
+static inline unsigned ff_exp(uint64_t x)
+{
+    return (x >> 52) & 0x7ff;
+}
+
+static inline bool ff_zero(uint64_t x)
+{
+    return !(x & FF_ABS);
+}
+
+/* normal number (no zero, denormal, infinity or NaN) */
+static inline bool ff_normal(uint64_t x)
+{
+    return ff_exp(x) - 1u < 0x7feu;
+}
+
+/* operand of add/subtract: zero, or normal with |x| < 2^1022 */
+static inline bool ff_addend(uint64_t x)
+{
+    return ff_exp(x) - 1u < 0x7fdu || ff_zero(x);
+}
+
+static inline bool ff_normal_or_zero(uint64_t x)
+{
+    return ff_normal(x) || ff_zero(x);
+}
+
+/* double result: normal, above the smallest normal, finite */
+static inline bool ff_res_ok(uint64_t r)
+{
+    uint64_t a = r & FF_ABS;
+    return a > FF_MINN && a < FF_INF;
+}
+
+/* single-precision result in double format: above FLT_MIN, at most FLT_MAX */
+static inline bool ff_res_ok_s(uint64_t r)
+{
+    uint64_t a = r & FF_ABS;
+    return a > FF_S_MIN && a <= FF_S_MAX;
+}
+
+static inline uint64_t ff_sig(uint64_t x)
+{
+    return (x & FF_FRAC) | FF_HIDDEN;
+}
+
+/* is the product of two 53-bit significands representable in 53 bits? */
+static inline bool ff_mul_exact(uint64_t ma, uint64_t mb)
+{
+    uint64_t oa = ma >> ctz64(ma);
+    uint64_t ob = mb >> ctz64(mb);
+    int bits = (64 - clz64(oa)) + (64 - clz64(ob));
+
+    if (bits <= 53) {
+        return true;
+    }
+    if (bits > 54) {
+        return false;
+    }
+    return oa * ob < (1ULL << 53);
+}
+
+static inline unsigned ff_fprf(uint64_t r)
+{
+    if (r & FF_ABS) {
+        return (r >> 63) ? 0x08 : 0x04;     /* -normal, +normal */
+    }
+    return (r >> 63) ? 0x12 : 0x02;         /* -zero, +zero */
+}
+
+static inline bool ff_ok(CPUPPCState *env)
+{
+    return !(env->fpscr & FP_XE) &&
+           get_float_rounding_mode(&env->fp_status) == float_round_nearest_even &&
+           env_cpu(env)->exception_index != POWERPC_EXCP_PROGRAM;
+}
+
+/* the FPSCR and status flags of compute_fprf + float_check_status */
+static inline void ff_done(CPUPPCState *env, uint64_t r, bool inexact)
+{
+    target_ulong f = env->fpscr & ~(target_ulong)(FP_FPRF | FP_FI);
+
+    f |= (target_ulong)ff_fprf(r) << FPSCR_FPRF;
+    if (inexact) {
+        f |= FP_XX | FP_FX | FP_FI;
+    }
+    env->fpscr = f;
+    set_float_exception_flags(inexact ? float_flag_inexact : 0, &env->fp_status);
+}
+
+/* the same without FPRF (conversions to integer) */
+static inline void ff_done_nofprf(CPUPPCState *env, bool inexact)
+{
+    target_ulong f = env->fpscr & ~(target_ulong)FP_FI;
+
+    if (inexact) {
+        f |= FP_XX | FP_FX | FP_FI;
+    }
+    env->fpscr = f;
+    set_float_exception_flags(inexact ? float_flag_inexact : 0, &env->fp_status);
+}
+
+/*
+ * Round a double result s, whose exact value is s + (nonzero if exact53 is
+ * false), to single precision.  RN53 cannot step over a single-precision
+ * midpoint (midpoints are doubles), so RN24(s) is RN24(exact) unless s is
+ * itself a midpoint and the exact value is not s: then give up.
+ */
+static inline bool ff_to_single(double s, bool exact53, uint64_t *res,
+                                bool *inexact)
+{
+    uint64_t rs = ff_u(s);
+    float y;
+    double yd;
+    uint64_t ry;
+
+    if (ff_zero(rs)) {
+        if (!exact53) {
+            return false;
+        }
+        *res = rs;
+        *inexact = false;
+        return true;
+    }
+    if (!exact53 && (rs & FF_S_LOW) == FF_S_HALF) {
+        return false;
+    }
+    y = (float)s;
+    yd = y;
+    ry = ff_u(yd);
+    if (!ff_res_ok_s(ry)) {
+        return false;
+    }
+    *res = ry;
+    *inexact = !exact53 || yd != s;
+    return true;
+}
+
+/* a + b (b already negated for subtraction) */
+static inline bool ff_add(uint64_t a, uint64_t b, bool single, uint64_t *res,
+                          bool *inexact)
+{
+    double da, db, s, bb, err;
+    uint64_t rs;
+
+    if (!ff_addend(a) || !ff_addend(b)) {
+        return false;
+    }
+    da = ff_d(a);
+    db = ff_d(b);
+    s = da + db;
+    /* 2Sum: s + err == a + b exactly */
+    bb = s - da;
+    err = (da - (s - bb)) + (db - bb);
+    if (single) {
+        return ff_to_single(s, err == 0, res, inexact);
+    }
+    rs = ff_u(s);
+    if (!ff_res_ok(rs) && !ff_zero(rs)) {
+        return false;
+    }
+    *res = rs;
+    *inexact = err != 0;
+    return true;
+}
+
+static inline bool ff_mul(uint64_t a, uint64_t b, bool single, uint64_t *res,
+                          bool *inexact)
+{
+    double p;
+    uint64_t rp;
+    bool exact;
+
+    if (!ff_normal_or_zero(a) || !ff_normal_or_zero(b)) {
+        return false;
+    }
+    p = ff_d(a) * ff_d(b);
+    rp = ff_u(p);
+    if (ff_zero(a) || ff_zero(b)) {
+        *res = rp;                              /* signed zero, exact */
+        *inexact = false;
+        return true;
+    }
+    exact = ff_mul_exact(ff_sig(a), ff_sig(b));
+    if (single) {
+        return ff_normal(rp) && ff_to_single(p, exact, res, inexact);
+    }
+    if (!ff_res_ok(rp)) {
+        return false;
+    }
+    *res = rp;
+    *inexact = !exact;
+    return true;
+}
+
+static inline bool ff_div(uint64_t a, uint64_t b, bool single, uint64_t *res,
+                          bool *inexact)
+{
+    double q;
+    uint64_t rq;
+    bool exact;
+
+    /* |a| >= 2^-1021 keeps q * b, which is close to a, out of the denormals */
+    if ((!ff_zero(a) && ff_exp(a) - 2u >= 0x7fdu) || !ff_normal(b)) {
+        return false;
+    }
+    q = ff_d(a) / ff_d(b);
+    rq = ff_u(q);
+    if (ff_zero(a)) {
+        *res = rq;
+        *inexact = false;
+        return true;
+    }
+    if (!ff_res_ok(rq)) {
+        return false;
+    }
+    /* a / b == q exactly iff q * b is exact and equals a */
+    exact = ff_mul_exact(ff_sig(rq), ff_sig(b)) && q * ff_d(b) == ff_d(a);
+    if (single) {
+        return ff_to_single(q, exact, res, inexact);
+    }
+    *res = rq;
+    *inexact = !exact;
+    return true;
+}
+
+#if FF_ENABLED
+typedef unsigned __int128 ff_u128;
+
+static inline int ff_clz128(ff_u128 v)
+{
+    uint64_t hi = v >> 64;
+    return hi ? clz64(hi) : 64 + clz64((uint64_t)v);
+}
+
+/* round a left-normalised exact sum (msb at bit 127) and pack */
+static inline bool ff_round_pack(ff_u128 s, int e, bool sign, bool single,
+                                uint64_t *res, bool *inexact)
+{
+    uint64_t hi = s >> 64, lo = (uint64_t)s;
+    uint64_t sig, rb, st;
+
+    if (single) {
+        sig = hi >> 40;
+        rb = (hi >> 39) & 1;
+        st = (hi & ((1ULL << 39) - 1)) | lo;
+    } else {
+        sig = hi >> 11;
+        rb = (hi >> 10) & 1;
+        st = (hi & 0x3ff) | lo;
+    }
+    if (e < (single ? -126 : -1022)) {
+        return false;                       /* tiny before rounding */
+    }
+    if (rb && (st || (sig & 1))) {
+        sig++;
+        if (sig >> (single ? 24 : 53)) {
+            sig >>= 1;
+            e++;
+        }
+    }
+    if (e > (single ? 127 : 1023)) {
+        return false;                       /* overflow */
+    }
+    if (single) {
+        *res = ((uint64_t)sign << 63) | ((uint64_t)(e + 1023) << 52) |
+               ((sig & 0x7fffff) << 29);
+    } else {
+        *res = ((uint64_t)sign << 63) | ((uint64_t)(e + 1023) << 52) |
+               (sig & FF_FRAC);
+    }
+    *inexact = rb || st;
+    return true;
+}
+
+/*
+ * x * y + z, exact, rounded once to nearest-even at 53 bits (double) or
+ * 24 bits with the single exponent range (single).  x and y normal, z
+ * normal or zero, signs final (fmsub negates z before the call).  Returns
+ * false for an exact zero sum, a tiny or overflowing result.
+ *
+ * The product (106 bits) and z are added exactly in 128 bits: the operand
+ * with the larger weight of its least significant bit is shifted left onto
+ * the other one's, which fits whenever |z| is within 2^-72..2^21 of |x*y|.
+ * Otherwise the smaller operand is shifted right with a sticky bit (it then
+ * lies entirely below the rounding position, see the jam argument in the
+ * report).
+ */
+static bool ff_fma_core(uint64_t x, uint64_t y, uint64_t z, bool single,
+                        uint64_t *res, bool *inexact)
+{
+    bool sp = (x ^ y) >> 63;
+    bool sign = sp;
+    ff_u128 p = (ff_u128)ff_sig(x) * ff_sig(y);     /* [2^104, 2^106) */
+    int wp = (int)ff_exp(x) + (int)ff_exp(y) - 2150; /* weight of bit 0 */
+    ff_u128 s;
+    int w, lz;
+
+    if (ff_zero(z)) {
+        s = p;
+        w = wp;
+    } else {
+        ff_u128 q = ff_sig(z);                      /* [2^52, 2^53) */
+        int wq = (int)ff_exp(z) - 1075;
+        int d = wq - wp;
+        bool sz = z >> 63;
+
+        if (d >= 0 && d <= 74) {
+            q <<= d;                                /* msb <= bit 126 */
+            w = wp;
+        } else if (d < 0 && d >= -21) {
+            p <<= -d;                               /* msb <= bit 126 */
+            w = wq;
+        } else if (d > 74) {
+            /* z dominates: product below z's lsb by 2^22+ */
+            int sh = d - 74;
+            q <<= 74;
+            p = sh >= 127 ? (p != 0)
+                          : (p >> sh) | ((p & (((ff_u128)1 << sh) - 1)) != 0);
+            w = wq - 74;
+        } else {
+            /* product dominates: z below the product's lsb by 2^21+ */
+            int sh = -d - 21;
+            p <<= 21;
+            q = sh >= 127 ? (q != 0)
+                          : (q >> sh) | ((q & (((ff_u128)1 << sh) - 1)) != 0);
+            w = wp - 21;
+        }
+        if (sp == sz) {
+            s = p + q;
+        } else if (p >= q) {
+            s = p - q;
+        } else {
+            s = q - p;
+            sign = sz;
+        }
+        if (s == 0) {
+            return false;
+        }
+    }
+    lz = ff_clz128(s);
+    s <<= lz;
+    return ff_round_pack(s, w + 127 - lz, sign, single, res, inexact);
+}
+
+/*
+ * Single-precision a * c + b when the double product is not exact (operands
+ * that are not singles, e.g. double constants).  s = RN53(RN53(a * c) + b)
+ * differs from the exact x by at most B = ulp(p)/2 + ulp(s)/2, i.e.
+ * 2^(d-1) + 1/2 units of ulp(s) with d = exp(p) - exp(s).  RN24 is constant
+ * between single-precision midpoints, so RN24(s) = RN24(x) when s is more
+ * than B from the nearest midpoint; and x is not a single (inexact) when s
+ * is more than B from the nearest single.  Otherwise give up.
+ */
+static inline bool ff_fma_single_bounded(uint64_t a, uint64_t c, uint64_t b,
+                                         uint64_t *res, bool *inexact)
+{
+    double p = ff_d(a) * ff_d(c);
+    double s;
+    uint64_t rp = ff_u(p), rs, low, mid, grid, need, ry;
+    int d;
+
+    if (ff_exp(rp) - 2u >= 0x7fcu || !ff_addend(b)) {
+        return false;
+    }
+    s = p + ff_d(b);
+    rs = ff_u(s);
+    if (!ff_normal(rs)) {
+        return false;
+    }
+    d = (int)ff_exp(rp) - (int)ff_exp(rs);
+    if (d > 20) {
+        return false;                       /* heavy cancellation */
+    }
+    need = d <= 0 ? 2 : (1ULL << (d - 1)) + 1;
+    low = rs & FF_S_LOW;
+    mid = low > FF_S_HALF ? low - FF_S_HALF : FF_S_HALF - low;
+    grid = low < FF_S_HALF ? low : (FF_S_LOW + 1) - low;
+    if (mid < need || grid < need) {
+        return false;
+    }
+    ry = ff_u((double)(float)s);
+    if (!ff_res_ok_s(ry)) {
+        return false;
+    }
+    *res = ry;
+    *inexact = true;
+    return true;
+}
+
+/* fmadd family: madd_flags as for float64_muladd */
+static bool ff_fma(uint64_t a, uint64_t c, uint64_t b, int madd_flags,
+                   bool single, uint64_t *res, bool *inexact)
+{
+    uint64_t r;
+
+    if (madd_flags & float_muladd_negate_c) {
+        b ^= FF_SIGN;
+    }
+    if (!ff_normal_or_zero(a) || !ff_normal_or_zero(c) ||
+        !ff_normal_or_zero(b)) {
+        return false;
+    }
+    if (ff_zero(a) || ff_zero(c)) {
+        /* zero product: the sum is b, or a signed zero */
+        bool sp = (a ^ c) >> 63;
+        if (ff_zero(b)) {
+            r = (sp && (b >> 63)) ? FF_SIGN : 0;
+            *inexact = false;
+        } else if (single) {
+            if (!ff_to_single(ff_d(b), true, &r, inexact)) {
+                return false;
+            }
+        } else {
+            r = b;
+            *inexact = false;
+        }
+    } else if (ff_mul_exact(ff_sig(a), ff_sig(c)) && ff_addend(b) &&
+               ff_exp(ff_u(ff_d(a) * ff_d(c))) - 2u < 0x7fcu) {
+        /*
+         * exact product: one 2Sum gives the exact sum.  The integer test
+         * only covers the significand: the product must also be normal, so
+         * its exponent must be at least 2 (a product that rounded up to the
+         * smallest normal may have lost a bit to denormalisation).
+         */
+        double p = ff_d(a) * ff_d(c);
+        double db = ff_d(b);
+        double t = p + db;
+        double bb = t - p;
+        double err = (p - (t - bb)) + (db - bb);
+        uint64_t rt = ff_u(t);
+
+        if (single) {
+            if (!ff_to_single(t, err == 0, &r, inexact)) {
+                return false;
+            }
+        } else if (ff_res_ok(rt) || (ff_zero(rt) && err == 0)) {
+            r = rt;
+            *inexact = err != 0;
+        } else {
+            return false;
+        }
+    } else if (single && ff_fma_single_bounded(a, c, b, &r, inexact)) {
+        /* r and inexact set */
+    } else if (!ff_fma_core(a, c, b, single, &r, inexact)) {
+        return false;
+    }
+    if (madd_flags & float_muladd_negate_result) {
+        r ^= FF_SIGN;
+    }
+    *res = r;
+    return true;
+}
+#endif
+
+static inline void ff_set_fpr(CPUPPCState *env, uint32_t frt, uint64_t v)
+{
+    *cpu_fpr_ptr(env, frt) = v;
+}
+
+/* tail of the original sequence: FPR written, then FPRF and status */
+static uint64_t ff_slow_finish(CPUPPCState *env, uint32_t frt, uint64_t r,
+                               uintptr_t ra)
+{
+    ff_set_fpr(env, frt, r);
+    helper_compute_fprf_float64(env, r);
+    do_float_check_status(env, true, ra);
+    return r;
+}
+
+#define FF_BINOP(NAME, SOFT, HANDLER, FAST, NEG, SINGLE)                      \
+uint64_t helper_fast_##NAME(CPUPPCState *env, uint64_t a, uint64_t b,         \
+                            uint32_t frt)                                     \
+{                                                                             \
+    uintptr_t ra = GETPC();                                                   \
+    uint64_t r;                                                               \
+    bool inexact;                                                             \
+                                                                              \
+    if (FF_ENABLED && likely(ff_ok(env)) &&                                   \
+        likely(FAST(a, (NEG) ? b ^ FF_SIGN : b, SINGLE, &r, &inexact))) {     \
+        ff_done(env, r, inexact);                                             \
+        FF_STAT(#NAME, true);                                                 \
+        return r;                                                             \
+    }                                                                         \
+    FF_STAT(#NAME, false);                                                    \
+    set_float_exception_flags(0, &env->fp_status);                            \
+    r = SOFT(a, b, &env->fp_status);                                          \
+    HANDLER(env, get_float_exception_flags(&env->fp_status), ra);             \
+    return ff_slow_finish(env, frt, r, ra);                                   \
+}
+
+FF_BINOP(FADD, float64_add, addsub_flags_handler, ff_add, false, false)
+FF_BINOP(FADDS, float64r32_add, addsub_flags_handler, ff_add, false, true)
+FF_BINOP(FSUB, float64_sub, addsub_flags_handler, ff_add, true, false)
+FF_BINOP(FSUBS, float64r32_sub, addsub_flags_handler, ff_add, true, true)
+FF_BINOP(FMUL, float64_mul, mul_flags_handler, ff_mul, false, false)
+FF_BINOP(FMULS, float64r32_mul, mul_flags_handler, ff_mul, false, true)
+FF_BINOP(FDIV, float64_div, div_flags_handler, ff_div, false, false)
+FF_BINOP(FDIVS, float64r32_div, div_flags_handler, ff_div, false, true)
+
+#if FF_ENABLED
+#define FF_FMA_FAST(a, c, b, fl, s, r, ix) ff_fma(a, c, b, fl, s, r, ix)
+#else
+#define FF_FMA_FAST(a, c, b, fl, s, r, ix) false
+#endif
+
+#define FF_FMA(NAME, FLAGS)                                                   \
+uint64_t helper_fast_##NAME(CPUPPCState *env, uint64_t a, uint64_t c,         \
+                            uint64_t b, uint32_t frt)                         \
+{                                                                             \
+    uintptr_t ra = GETPC();                                                   \
+    uint64_t r;                                                               \
+    bool inexact;                                                             \
+                                                                              \
+    if (likely(ff_ok(env)) &&                                                 \
+        likely(FF_FMA_FAST(a, c, b, FLAGS, false, &r, &inexact))) {           \
+        ff_done(env, r, inexact);                                             \
+        FF_STAT(#NAME, true);                                                 \
+        return r;                                                             \
+    }                                                                         \
+    FF_STAT(#NAME, false);                                                    \
+    set_float_exception_flags(0, &env->fp_status);                            \
+    r = do_fmadd(env, a, c, b, FLAGS, ra);                                    \
+    return ff_slow_finish(env, frt, r, ra);                                   \
+}                                                                             \
+uint64_t helper_fast_##NAME##S(CPUPPCState *env, uint64_t a, uint64_t c,      \
+                               uint64_t b, uint32_t frt)                      \
+{                                                                             \
+    uintptr_t ra = GETPC();                                                   \
+    uint64_t r;                                                               \
+    bool inexact;                                                             \
+                                                                              \
+    if (likely(ff_ok(env)) &&                                                 \
+        likely(FF_FMA_FAST(a, c, b, FLAGS, true, &r, &inexact))) {            \
+        ff_done(env, r, inexact);                                             \
+        FF_STAT(#NAME "S", true);                                             \
+        return r;                                                             \
+    }                                                                         \
+    FF_STAT(#NAME "S", false);                                                \
+    set_float_exception_flags(0, &env->fp_status);                            \
+    r = do_fmadds(env, a, c, b, FLAGS, ra);                                   \
+    return ff_slow_finish(env, frt, r, ra);                                   \
+}
+
+FF_FMA(FMADD, MADD_FLGS)
+FF_FMA(FNMADD, NMADD_FLGS)
+FF_FMA(FMSUB, MSUB_FLGS)
+FF_FMA(FNMSUB, NMSUB_FLGS)
+
+/* fres: 1 / b rounded to single (QEMU computes the estimate exactly) */
+uint64_t helper_fast_FRES(CPUPPCState *env, uint64_t b, uint32_t frt)
+{
+    uintptr_t ra = GETPC();
+    uint64_t r;
+    bool inexact;
+    int flags;
+
+    if (FF_ENABLED && likely(ff_ok(env)) &&
+        likely(ff_div(0x3ff0000000000000ULL, b, true, &r, &inexact))) {
+        ff_done(env, r, inexact);
+        FF_STAT("FRES", true);
+        return r;
+    }
+    FF_STAT("FRES", false);
+    set_float_exception_flags(0, &env->fp_status);
+    r = float64r32_div(float64_one, b, &env->fp_status);
+    flags = get_float_exception_flags(&env->fp_status);
+    if (unlikely(flags & float_flag_invalid_snan)) {
+        float_invalid_op_vxsnan(env, ra);
+    }
+    if (unlikely(flags & float_flag_divbyzero)) {
+        float_zero_divide_excp(env, ra);
+        /* For FPSCR.ZE == 0, the result is 1/2.  */
+        r = float64_set_sign(float64_half, float64_is_neg(b));
+    }
+    return ff_slow_finish(env, frt, r, ra);
+}
+
+/* frsqrte: 1 / sqrt(b), double precision, two roundings as in QEMU */
+uint64_t helper_fast_FRSQRTE(CPUPPCState *env, uint64_t b, uint32_t frt)
+{
+    uintptr_t ra = GETPC();
+    uint64_t r;
+    int flags;
+
+    if (FF_ENABLED && likely(ff_ok(env)) && ff_normal(b) && !(b >> 63)) {
+        double s = __builtin_sqrt(ff_d(b));
+        uint64_t rs = ff_u(s);
+        bool exact_s = ff_mul_exact(ff_sig(rs), ff_sig(rs)) && s * s == ff_d(b);
+        double d = 1.0 / s;
+
+        r = ff_u(d);
+        /* 1 / s is exact iff s is a power of two */
+        ff_done(env, r, !exact_s || (rs & FF_FRAC) != 0);
+        FF_STAT("FRSQRTE", true);
+        return r;
+    }
+    FF_STAT("FRSQRTE", false);
+    set_float_exception_flags(0, &env->fp_status);
+    {
+        float64 rets = float64_sqrt(b, &env->fp_status);
+        r = float64_div(float64_one, rets, &env->fp_status);
+    }
+    flags = get_float_exception_flags(&env->fp_status);
+    if (unlikely(flags & float_flag_invalid)) {
+        float_invalid_op_sqrt(env, flags, 1, ra);
+    }
+    if (unlikely(flags & float_flag_divbyzero)) {
+        /* Reciprocal of (square root of) zero.  */
+        float_zero_divide_excp(env, ra);
+    }
+    return ff_slow_finish(env, frt, r, ra);
+}
+
+/* frsp */
+uint64_t helper_fast_FRSP(CPUPPCState *env, uint64_t b, uint32_t frt)
+{
+    uintptr_t ra = GETPC();
+    uint64_t r;
+    bool inexact;
+
+    if (FF_ENABLED && likely(ff_ok(env)) && ff_normal_or_zero(b) &&
+        ff_to_single(ff_d(b), true, &r, &inexact)) {
+        ff_done(env, r, inexact);
+        FF_STAT("FRSP", true);
+        return r;
+    }
+    FF_STAT("FRSP", false);
+    set_float_exception_flags(0, &env->fp_status);
+    r = do_frsp(env, b, ra);
+    return ff_slow_finish(env, frt, r, ra);
+}
+
+/* fctiw, fctiwz: |b| < 2^31, result within int32 */
+static inline bool ff_cti(uint64_t b, bool trunc, uint64_t *res, bool *inexact)
+{
+    double d, t;
+    int64_t v;
+
+    if (!ff_zero(b) && ff_exp(b) - 1u >= 1023 + 31 - 1) {
+        return false;
+    }
+    d = ff_d(b);
+    if (trunc) {
+        v = (int64_t)d;
+    } else {
+        /* round to nearest even at the units place */
+        t = __builtin_fabs(d);
+        t = (t + 0x1p52) - 0x1p52;
+        v = (int64_t)t;
+        if (b >> 63) {
+            v = -v;
+        }
+    }
+    if (v < INT32_MIN || v > INT32_MAX) {
+        return false;
+    }
+    *res = (uint64_t)(int64_t)(int32_t)v;
+    *inexact = (double)v != d;
+    return true;
+}
+
+#define FF_CTI(NAME, CVT, TRUNC)                                              \
+uint64_t helper_fast_##NAME(CPUPPCState *env, uint64_t b, uint32_t frt)       \
+{                                                                             \
+    uintptr_t ra = GETPC();                                                   \
+    uint64_t r;                                                               \
+    bool inexact;                                                             \
+    int flags;                                                                \
+                                                                              \
+    if (FF_ENABLED && likely(ff_ok(env)) &&                                   \
+        likely(ff_cti(b, TRUNC, &r, &inexact))) {                             \
+        ff_done_nofprf(env, inexact);                                         \
+        FF_STAT(#NAME, true);                                                 \
+        return r;                                                             \
+    }                                                                         \
+    FF_STAT(#NAME, false);                                                    \
+    set_float_exception_flags(0, &env->fp_status);                            \
+    r = float64_to_##CVT(b, &env->fp_status);                                 \
+    flags = get_float_exception_flags(&env->fp_status);                       \
+    if (unlikely(flags & float_flag_invalid)) {                               \
+        r = float_invalid_cvt(env, flags, r, 0x80000000U, 1, ra);             \
+    }                                                                         \
+    ff_set_fpr(env, frt, r);                                                  \
+    do_float_check_status(env, true, ra);                                     \
+    return r;                                                                 \
+}
+
+FF_CTI(FCTIW, int32, false)
+FF_CTI(FCTIWZ, int32_round_to_zero, true)
+
+/* fcmpu, fcmpo: ordered operands only; FI is cleared as by check_status */
+static inline bool ff_cmp(CPUPPCState *env, uint64_t a, uint64_t b,
+                          uint32_t crf)
+{
+    double da, db;
+    uint32_t c;
+
+    if (!ff_normal_or_zero(a) || !ff_normal_or_zero(b)) {
+        return false;
+    }
+    da = ff_d(a);
+    db = ff_d(b);
+    c = da < db ? 0x08 : da > db ? 0x04 : 0x02;
+    env->fpscr = (env->fpscr & ~(target_ulong)(FP_FPCC | FP_FI)) |
+                 ((target_ulong)c << FPSCR_FPCC);
+    env->crf[crf] = c;
+    set_float_exception_flags(0, &env->fp_status);
+    return true;
+}
+
+void helper_fast_FCMPU(CPUPPCState *env, uint64_t a, uint64_t b, uint32_t crf)
+{
+    if (FF_ENABLED && likely(ff_ok(env)) && likely(ff_cmp(env, a, b, crf))) {
+        FF_STAT("FCMPU", true);
+        return;
+    }
+    FF_STAT("FCMPU", false);
+    set_float_exception_flags(0, &env->fp_status);
+    ff_fcmpu(env, a, b, crf, GETPC());
+    do_float_check_status(env, true, GETPC());
+}
+
+void helper_fast_FCMPO(CPUPPCState *env, uint64_t a, uint64_t b, uint32_t crf)
+{
+    if (FF_ENABLED && likely(ff_ok(env)) && likely(ff_cmp(env, a, b, crf))) {
+        FF_STAT("FCMPO", true);
+        return;
+    }
+    FF_STAT("FCMPO", false);
+    set_float_exception_flags(0, &env->fp_status);
+    ff_fcmpo(env, a, b, crf, GETPC());
+    do_float_check_status(env, true, GETPC());
+}
