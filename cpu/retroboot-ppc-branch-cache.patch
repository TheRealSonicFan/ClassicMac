+/*
+ * RetroBoot fast-branch (exec/tb-slot.h).  XPAGE: a direct branch to
+ * another page cannot be chained with goto_tb (the page's mapping may
+ * change), so it went through helper_lookup_tb_ptr every time; instead it
+ * gets a slot of its own and jumps to the slot's code while the slot is
+ * valid.  RAS: bl and bctrl push a slot for their return address and blr
+ * pops one and jumps to its code when it is valid for LR and this TB's
+ * flags; a slot whose pc and flags match but which is stale is refilled,
+ * anything else continues with the guarded indirect branch below.
+ */
+static TCGv_i32 gen_slot_gen_ok(TCGv_ptr slot, TCGLabel *stale)
+{
+    TCGv_i32 g = tcg_temp_new_i32();
+    TCGv_i32 cur = tcg_temp_new_i32();
+
+    tcg_gen_ld_i32(g, slot, offsetof(TBSlot, gen));
+    tcg_gen_ld_i32(cur, tcg_constant_ptr(&tcg_tb_gen), 0);
+    tcg_gen_brcond_i32(TCG_COND_NE, g, cur, stale);
+    return g;
+}
+
+static bool gen_goto_slot(DisasContext *ctx, target_ulong dest)
+{
+    TBSlot *s;
+    TCGv_ptr sp, code;
+    TCGLabel *stale;
+
+    if (!(ctx->fast_branch & PPC_FAST_BRANCH_XPAGE) || NARROW_MODE(ctx) ||
+        !(s = tcg_tb_slot_new(dest, ctx->base.tb->flags))) {
+        return false;
+    }
+    sp = tcg_constant_ptr(s);
+    code = tcg_temp_new_ptr();
+    stale = gen_new_label();
+    gen_slot_gen_ok(sp, stale);
+    tcg_gen_ld_ptr(code, sp, offsetof(TBSlot, code));
+    tcg_gen_goto_code_ptr(code);
+    gen_set_label(stale);
+    tcg_gen_movi_tl(cpu_nip, dest);
+    tcg_gen_lookup_slot_and_goto_ptr(sp);
+    return true;
+}
