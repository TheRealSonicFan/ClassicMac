+
+    if (!(ctx->fast_branch & PPC_FAST_BRANCH_RAS) || NARROW_MODE(ctx)) {
+        return;
+    }
+    miss = gen_new_label();
+    stale = gen_new_label();
+    top = tcg_temp_new_i32();
+    t = tcg_temp_new_i32();
+    p = tcg_temp_new_ptr();
+    s = tcg_temp_new_ptr();
+    tcg_gen_ld_i32(top, tcg_env, offsetof(CPUPPCState, rb_ras_top));
+    tcg_gen_subi_i32(t, top, 1);
+    tcg_gen_andi_i32(t, t, PPC_RB_RAS_N - 1);
+    tcg_gen_st_i32(t, tcg_env, offsetof(CPUPPCState, rb_ras_top));
+    tcg_gen_muli_i32(top, top, sizeof(void *));
+    tcg_gen_ext_i32_ptr(p, top);
+    tcg_gen_add_ptr(p, p, tcg_env);
+    tcg_gen_ld_ptr(s, p, offsetof(CPUPPCState, rb_ras));
