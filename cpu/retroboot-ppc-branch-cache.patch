+        !(s = tcg_tb_slot_new(ret, ctx->base.tb->flags))) {
+        return;
+    }
+    top = tcg_temp_new_i32();
+    p = tcg_temp_new_ptr();
+    tcg_gen_ld_i32(top, tcg_env, offsetof(CPUPPCState, rb_ras_top));
+    tcg_gen_addi_i32(top, top, 1);
+    tcg_gen_andi_i32(top, top, PPC_RB_RAS_N - 1);
+    tcg_gen_st_i32(top, tcg_env, offsetof(CPUPPCState, rb_ras_top));
+    tcg_gen_muli_i32(top, top, sizeof(void *));
+    tcg_gen_ext_i32_ptr(p, top);
+    tcg_gen_add_ptr(p, p, tcg_env);
+    tcg_gen_st_ptr(tcg_constant_ptr(s), p, offsetof(CPUPPCState, rb_ras));
+}
