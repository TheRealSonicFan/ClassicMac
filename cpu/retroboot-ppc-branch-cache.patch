+
+/*
+ * RetroBoot TB slots (exec/tb-slot.h): the arena is allocated on first use
+ * and recycled by tb_flush; translation allocates, the vCPU fills.
+ */
+#define TB_SLOT_ARENA (1u << 20)
+
+uint32_t tcg_tb_gen = 1;
+TBSlot tcg_tb_slot_none = { .pc = UINT64_MAX, .gen = 0 };
+static TBSlot *tb_slot_arena;
+static unsigned tb_slot_next;
+
+TBSlot *tcg_tb_slot_new(uint64_t pc, uint32_t flags)
+{
+    unsigned i;
+    TBSlot *s;
+
+    if (unlikely(!tb_slot_arena)) {
+        tb_slot_arena = g_new0(TBSlot, TB_SLOT_ARENA);
+    }
+    i = qatomic_fetch_inc(&tb_slot_next);
+    if (i >= TB_SLOT_ARENA) {
+        return NULL;
+    }
+    s = &tb_slot_arena[i];
+    s->pc = pc;
+    s->flags = flags;
+    s->gen = 0;
+    s->code = NULL;
+    return s;
+}
+
+void tcg_tb_gen_bump(void)
+{
+    qatomic_inc(&tcg_tb_gen);
+}
+
+void tcg_tb_slot_reset(void)
+{
+    tcg_tb_gen_bump();
+    qatomic_set(&tb_slot_next, 0);
+}
+
+const void *HELPER(lookup_tb_slot)(CPUArchState *env, void *p)
+{
+    TBSlot *slot = p;
+    CPUState *cpu = env_cpu(env);
+    TCGTBCPUState s = {
+        .pc = slot->pc,
+        .flags = slot->flags,
+        .cflags = curr_cflags(cpu),
+    };
+    /* read before the lookup: an invalidation in between leaves it stale */
+    uint32_t gen = qatomic_read(&tcg_tb_gen);
+    TranslationBlock *tb;
+
+    cpu->neg.can_do_io = true;
+    RB_STAT("lookup.slot");
+
+    if (unlikely(!QTAILQ_EMPTY(&cpu->breakpoints)) ||
+        unlikely(qemu_loglevel_mask(CPU_LOG_TB_CPU | CPU_LOG_EXEC))) {
+        return tcg_code_gen_epilogue;
+    }
+
+    tb = tb_lookup(cpu, s);
+    if (tb == NULL) {
+        return tcg_code_gen_epilogue;
+    }
+    slot->code = tb->tc.ptr;
+    slot->gen = gen;
+    return tb->tc.ptr;
 }
 
+/* the same for a slot that follows a computed branch: it now caches @pc */
+const void *HELPER(lookup_tb_slot_pc)(CPUArchState *env, void *p, uint64_t pc)
+{
+    TBSlot *slot = p;
+
+    slot->gen = 0;
+    slot->pc = pc;
+    return HELPER(lookup_tb_slot)(env, p);
+}
