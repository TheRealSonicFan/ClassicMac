diff --git a/include/exec/tb-slot.h b/include/exec/tb-slot.h
new file mode 100644
--- /dev/null
+++ b/include/exec/tb-slot.h
@@ -0,0 +1,44 @@
+/*
+ * RetroBoot: cached branch destinations for translated code (TB slots).
+ *
+ * A slot caches the host code of the TB for (pc, flags) exactly as a jump
+ * cache entry would, and is valid while tcg_tb_gen still equals the
+ * generation it was filled in.  The generation advances whenever an entry
+ * of any CPU's jump cache could become stale: a whole or partial jump cache
+ * flush (TLB flushes, tb_flush), a page or class of pages cleared from it,
+ * or a TB invalidated.  tb_flush also recycles the slot arena; a slot that
+ * is reused only ever matches a pc, flags and generation it was filled for.
+ *
+ * Translated code checks the generation (and, for a slot it did not
+ * allocate itself, pc and flags) and jumps to the cached code; otherwise it
+ * calls helper_lookup_tb_slot, which looks the TB up like
+ * helper_lookup_tb_ptr_fast and refills the slot.  The cached TB is the one
+ * found through the translating CPU's mappings, so translators use slots
+ * only while there is a single vCPU.
+ */
+#ifndef EXEC_TB_SLOT_H
+#define EXEC_TB_SLOT_H
+
+typedef struct TBSlot {
+    uint64_t pc;
+    uint32_t flags;
+    uint32_t gen;           /* 0: never valid */
+    const void *code;
+} TBSlot;
+
+/* starts at 1, never 0 in practice (2^32 invalidations) */
+extern uint32_t tcg_tb_gen;
+
+/* a slot that never matches (pc all-ones, generation 0) */
+extern TBSlot tcg_tb_slot_none;
+
+/* a fresh slot for (pc, flags), or NULL when the arena is used up */
+TBSlot *tcg_tb_slot_new(uint64_t pc, uint32_t flags);
+
+/* every cached destination may be stale */
+void tcg_tb_gen_bump(void);
+
+/* tb_flush: every slot is free again */
+void tcg_tb_slot_reset(void);
+
+#endif
diff --git a/include/qemu/rb-stats.h b/include/qemu/rb-stats.h
new file mode 100644
--- /dev/null
+++ b/include/qemu/rb-stats.h
@@ -0,0 +1,33 @@
+/*
+ * RetroBoot lab counters: configure --extra-cflags=-DRB_STATS.
+ * Each named counter is printed to stderr at exit and, with RB_STATS_PERIOD=N
+ * in the environment, every N seconds ("rb-stats T name count").
+ * Compiled out otherwise.
+ */
+#ifndef QEMU_RB_STATS_H
+#define QEMU_RB_STATS_H
+
+#ifdef RB_STATS
+typedef struct RBStat {
+    const char *name;
+    uint64_t n;
+    struct RBStat *next;
+    bool listed;
+} RBStat;
+
+void rb_stat_register(RBStat *s);
+
+static inline void rb_stat_add(RBStat *s, uint64_t k)
+{
+    if (unlikely(!s->listed)) {
+        rb_stat_register(s);
+    }
+    s->n += k;
+}
+#define RB_STAT(NAME) \
+    do { static RBStat rb_st_ = { .name = NAME }; rb_stat_add(&rb_st_, 1); } while (0)
+#else
+#define RB_STAT(NAME) do { } while (0)
+#endif
+
+#endif
