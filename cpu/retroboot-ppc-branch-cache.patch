+#ifdef RB_STATS
+static RBStat *rb_stat_list;
+static QemuMutex rb_stat_lock;
+static bool rb_stat_init_done;
+
+static void rb_stat_dump(const char *tag)
+{
+    for (RBStat *s = rb_stat_list; s; s = s->next) {
+        fprintf(stderr, "rb-stats %s %s %" PRIu64 "\n", tag, s->name, s->n);
+    }
+}
+
+static void rb_stat_dump_exit(void)
+{
+    rb_stat_dump("exit");
+}
+
+static void *rb_stat_thread(void *arg)
+{
+    unsigned period = (uintptr_t)arg;
+
+    for (;;) {
+        char tag[32];
+
+        g_usleep(period * G_USEC_PER_SEC);
+        snprintf(tag, sizeof(tag), "%.1f", g_get_real_time() / 1e6);
+        rb_stat_dump(tag);
+    }
+    return NULL;
+}
+
+void rb_stat_register(RBStat *s)
+{
+    if (!rb_stat_init_done) {
+        const char *p = getenv("RB_STATS_PERIOD");
+
+        rb_stat_init_done = true;
+        qemu_mutex_init(&rb_stat_lock);
+        atexit(rb_stat_dump_exit);
+        if (p && atoi(p) > 0) {
+            QemuThread t;
+            qemu_thread_create(&t, "rb-stats", rb_stat_thread,
+                               (void *)(uintptr_t)atoi(p), QEMU_THREAD_DETACHED);
+        }
+    }
+    qemu_mutex_lock(&rb_stat_lock);
+    if (!s->listed) {
+        s->next = rb_stat_list;
+        rb_stat_list = s;
+        s->listed = true;
+    }
+    qemu_mutex_unlock(&rb_stat_lock);
+}
+
+void HELPER(rb_count)(void *p)
+{
+    rb_stat_add(p, 1);
+}
+#endif
