+/*
+ * RetroBoot fast-fpu CALLS: the FP helpers are then called TCG_CALL_NO_RWG
+ * and write env->fpscr behind TCG's back, so FPSCR is read from memory, not
+ * through the cpu_fpscr global (which TCG code never writes, so its memory
+ * copy is always current and a register copy could be stale).
+ */
+static TCGv ff_fpscr(DisasContext *ctx)
+{
+    TCGv t;
+
+    if (!(ctx->fast_fpu & PPC_FAST_FPU_CALLS)) {
+        return cpu_fpscr;
+    }
+    t = tcg_temp_new();
+    tcg_gen_ld_tl(t, tcg_env, offsetof(CPUPPCState, fpscr));
+    return t;
+}
+
