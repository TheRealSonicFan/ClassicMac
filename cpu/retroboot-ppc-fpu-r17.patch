+/*
+ * RetroBoot fast-fpu VLDST: lve*x/stve*x as one guest memory access in
+ * TCG instead of a helper call.  The element is the one the helpers pick:
+ * index (EA & 0xf) / size in big-endian element numbering (reversed in
+ * little-endian mode), at byte offset EA & 0xf of the register image when
+ * host and guest byte orders agree and 16 - size - (EA & 0xf) otherwise;
+ * the access is big- or little-endian with MSR[LE] as in the helpers.
+ */
+static bool do_ldst_ve_inline(DisasContext *ctx, arg_X *a, int size,
+                              bool store)
+{
+    TCGv EA;
+    TCGv_ptr p;
+    TCGv_i32 v, off;
+    MemOp mop = size == 1 ? MO_UB : size == 2 ? MO_UW : MO_UL;
 
-TRANS(STVEBX, do_ldst_ve_X, 1, gen_helper_STVEBX);
-TRANS(STVEHX, do_ldst_ve_X, 2, gen_helper_STVEHX);
-TRANS(STVEWX, do_ldst_ve_X, 4, gen_helper_STVEWX);
+    REQUIRE_INSNS_FLAGS(ctx, ALTIVEC);
+    REQUIRE_VECTOR(ctx);
+    gen_set_access_type(ctx, ACCESS_INT);
+    EA = do_ea_calc(ctx, a->ra, cpu_gpr[a->rb]);
+    if (size > 1) {
+        tcg_gen_andi_tl(EA, EA, ~(size - 1));
+    }
+    off = tcg_temp_new_i32();
+    tcg_gen_trunc_tl_i32(off, EA);
+    tcg_gen_andi_i32(off, off, 0xf);
+    if (HOST_BIG_ENDIAN == ctx->le_mode) {
+        tcg_gen_subfi_i32(off, 16 - size, off);
+    }
+    p = tcg_temp_new_ptr();
+    tcg_gen_ext_i32_ptr(p, off);
+    tcg_gen_add_ptr(p, p, tcg_env);
+    v = tcg_temp_new_i32();
+    if (store) {
+        if (size == 1) {
+            tcg_gen_ld8u_i32(v, p, avr_full_offset(a->rt));
+        } else if (size == 2) {
+            tcg_gen_ld16u_i32(v, p, avr_full_offset(a->rt));
+        } else {
+            tcg_gen_ld_i32(v, p, avr_full_offset(a->rt));
+        }
+        tcg_gen_qemu_st_i32(v, EA, ctx->mem_idx, DEF_MEMOP(mop));
+    } else {
+        tcg_gen_qemu_ld_i32(v, EA, ctx->mem_idx, DEF_MEMOP(mop));
+        if (size == 1) {
+            tcg_gen_st8_i32(v, p, avr_full_offset(a->rt));
+        } else if (size == 2) {
+            tcg_gen_st16_i32(v, p, avr_full_offset(a->rt));
+        } else {
+            tcg_gen_st_i32(v, p, avr_full_offset(a->rt));
+        }
+    }
+    return true;
+}
 
