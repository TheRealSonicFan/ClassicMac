+
+/*
+ * PPC_FAST_FPU_SIMD (env->fast_vmx_simd): the same lanes four at a time
+ * with SSE2, which every x86-64 host has.  Each function computes exactly
+ * what the per-lane functions above compute, for all four lanes, and
+ * returns false (storing nothing) unless every lane passes the checks of
+ * its per-lane function; the caller then runs the per-lane loop, which
+ * gives the same results for those lanes and softfloat for the others.
+ * The host's MXCSR is round-to-nearest with FTZ and DAZ off, as for the
+ * scalar code.
+ */
+#if defined(__x86_64__) || (defined(__i386__) && defined(__SSE2__))
+#include <emmintrin.h>
+#include <tmmintrin.h>
+#include <cpuid.h>
+#define FV_SIMD 1
+
+static inline __m128i fv4_load(const ppc_avr_t *v)
+{
+    return _mm_loadu_si128((const __m128i *)v);
+}
+
+/* all-ones in each 32-bit lane holding a normal number or a zero (fv_nz) */
+static inline __m128i fv4_nz(__m128i x)
+{
+    __m128i a = _mm_and_si128(x, _mm_set1_epi32(0x7fffffff));
+
+    __m128i lo = _mm_cmpgt_epi32(a, _mm_set1_epi32(0x007fffff));
+    __m128i hi = _mm_cmplt_epi32(a, _mm_set1_epi32(0x7f800000));
+
+    return _mm_or_si128(_mm_cmpeq_epi32(a, _mm_setzero_si128()),
+                        _mm_and_si128(lo, hi));
+}
+
+/* zero, or normal above FLT_MIN and finite (fv_res) */
+static inline __m128i fv4_res(__m128i y)
+{
+    __m128i a = _mm_and_si128(y, _mm_set1_epi32(0x7fffffff));
+
+    __m128i lo = _mm_cmpgt_epi32(a, _mm_set1_epi32(0x00800000));
+    __m128i hi = _mm_cmplt_epi32(a, _mm_set1_epi32(0x7f800000));
+
+    return _mm_or_si128(_mm_cmpeq_epi32(a, _mm_setzero_si128()),
+                        _mm_and_si128(lo, hi));
+}
+
+static inline bool fv4_all(__m128i ok)
+{
+    return _mm_movemask_epi8(ok) == 0xffff;
+}
+
+/* 32-bit lane masks from the 64-bit masks of lanes 0-1 and 2-3 */
+static inline __m128i fv4_pack(__m128d lo, __m128d hi)
+{
+    return _mm_castps_si128(_mm_shuffle_ps(_mm_castpd_ps(lo), _mm_castpd_ps(hi),
+                                           _MM_SHUFFLE(2, 0, 2, 0)));
+}
+
+/* vaddfp, vsubfp: fv_add, fv_sub */
+static inline bool fv4_add(ppc_avr_t *r, const ppc_avr_t *a,
+                           const ppc_avr_t *b, bool sub)
+{
+    __m128i ia = fv4_load(a), ib = fv4_load(b);
+    __m128 fa = _mm_castsi128_ps(ia), fb = _mm_castsi128_ps(ib);
+    __m128i y = _mm_castps_si128(sub ? _mm_sub_ps(fa, fb) : _mm_add_ps(fa, fb));
+    __m128i ok = _mm_and_si128(_mm_and_si128(fv4_nz(ia), fv4_nz(ib)),
+                               fv4_res(y));
+
+    if (!fv4_all(ok)) {
+        return false;
+    }
+    _mm_storeu_si128((__m128i *)r, y);
     return true;
 }
+
+/* two lanes of fv_madd in double: s, and the lanes that must give up */
+static inline __m128 fv2_madd(__m128 fa, __m128 fc, __m128 fb, bool nmsub,
+                              __m128d *bad, __m128d *snz)
+{
+    __m128d zero = _mm_setzero_pd();
+    __m128d p = _mm_mul_pd(_mm_cvtps_pd(fa), _mm_cvtps_pd(fc));   /* exact */
+    __m128d db = _mm_cvtps_pd(fb);
+    __m128d s, bb, err, mid;
+    __m128i si;
+
+    if (nmsub) {
+        db = _mm_xor_pd(db, _mm_set1_pd(-0.0));
+    }
+    s = _mm_add_pd(p, db);
+    bb = _mm_sub_pd(s, p);
+    err = _mm_add_pd(_mm_sub_pd(p, _mm_sub_pd(s, bb)), _mm_sub_pd(db, bb));
+    /* s a single-precision midpoint: the low 29 bits are 1000...0 */
+    si = _mm_and_si128(_mm_castpd_si128(s), _mm_set1_epi32(0x1fffffff));
+    si = _mm_cmpeq_epi32(si, _mm_set1_epi32(0x10000000));
+    mid = _mm_castsi128_pd(_mm_shuffle_epi32(si, _MM_SHUFFLE(2, 2, 0, 0)));
+    *bad = _mm_and_pd(_mm_cmpneq_pd(err, zero),
+                      _mm_or_pd(_mm_cmpeq_pd(s, zero), mid));
+    *snz = _mm_cmpneq_pd(s, zero);
+    return _mm_cvtpd_ps(s);
+}
+
+/* vmaddfp, vnmsubfp: fv_madd */
+static inline bool fv4_madd(ppc_avr_t *r, const ppc_avr_t *a,
+                            const ppc_avr_t *c, const ppc_avr_t *b, bool nmsub)
+{
+    __m128i ia = fv4_load(a), ic = fv4_load(c), ib = fv4_load(b);
+    __m128 fa = _mm_castsi128_ps(ia), fc = _mm_castsi128_ps(ic);
+    __m128 fb = _mm_castsi128_ps(ib);
+    __m128d bad0, bad1, snz0, snz1;
+    __m128 y0, y1;
+    __m128i y, ok, yzero;
+
+    y0 = fv2_madd(fa, fc, fb, nmsub, &bad0, &snz0);
+    y1 = fv2_madd(_mm_movehl_ps(fa, fa), _mm_movehl_ps(fc, fc),
+                  _mm_movehl_ps(fb, fb), nmsub, &bad1, &snz1);
+    y = _mm_castps_si128(_mm_movelh_ps(y0, y1));
+    yzero = _mm_cmpeq_epi32(_mm_and_si128(y, _mm_set1_epi32(0x7fffffff)),
+                            _mm_setzero_si128());
+    ok = _mm_and_si128(_mm_and_si128(fv4_nz(ia), fv4_nz(ic)), fv4_nz(ib));
+    ok = _mm_and_si128(ok, fv4_res(y));
+    ok = _mm_andnot_si128(fv4_pack(bad0, bad1), ok);
+    ok = _mm_andnot_si128(_mm_and_si128(yzero, fv4_pack(snz0, snz1)), ok);
+    if (!fv4_all(ok)) {
+        return false;
+    }
+    if (nmsub) {
+        y = _mm_xor_si128(y, _mm_set1_epi32(0x80000000));
+    }
+    _mm_storeu_si128((__m128i *)r, y);
+    return true;
+}
+
+/* vmaxfp, vminfp: fv_max, fv_min (equal operands: max(+0,-0) = +0) */
+static inline bool fv4_maxmin(ppc_avr_t *r, const ppc_avr_t *a,
+                              const ppc_avr_t *b, bool max)
+{
+    __m128i ia = fv4_load(a), ib = fv4_load(b);
+    __m128 fa = _mm_castsi128_ps(ia), fb = _mm_castsi128_ps(ib);
+    __m128i gt = _mm_castps_si128(_mm_cmpgt_ps(fa, fb));
+    __m128i lt = _mm_castps_si128(_mm_cmplt_ps(fa, fb));
+    __m128i eq = max ? _mm_and_si128(ia, ib) : _mm_or_si128(ia, ib);
+    __m128i y;
+
+    if (!fv4_all(_mm_and_si128(fv4_nz(ia), fv4_nz(ib)))) {
+        return false;
+    }
+    if (max) {
+        y = _mm_or_si128(_mm_and_si128(gt, ia), _mm_and_si128(lt, ib));
+    } else {
+        y = _mm_or_si128(_mm_and_si128(lt, ia), _mm_and_si128(gt, ib));
+    }
+    y = _mm_or_si128(y, _mm_andnot_si128(_mm_or_si128(gt, lt), eq));
+    _mm_storeu_si128((__m128i *)r, y);
+    return true;
+}
+
+/* vrefp, vrsqrtefp: fv_re, fv_rsqrte (1/x and 1/sqrt(x), exact roundings) */
+static inline bool fv4_re(ppc_avr_t *r, const ppc_avr_t *b, bool rsqrt)
+{
+    __m128i ib = fv4_load(b);
+    __m128i a = _mm_and_si128(ib, _mm_set1_epi32(0x7fffffff));
+    __m128i ok = _mm_and_si128(_mm_cmpgt_epi32(a, _mm_set1_epi32(0x007fffff)),
+                               _mm_cmplt_epi32(a, _mm_set1_epi32(0x7f800000)));
+    __m128 fb = _mm_castsi128_ps(ib);
+    __m128i y;
+
+    if (rsqrt) {
+        ok = _mm_and_si128(ok, _mm_cmpeq_epi32(a, ib));     /* positive */
+        fb = _mm_sqrt_ps(fb);
+    }
+    if (!fv4_all(ok)) {
+        return false;
+    }
+    y = _mm_castps_si128(_mm_div_ps(_mm_set1_ps(1.0f), fb));
+    if (!fv4_all(fv4_res(y))) {
+        return false;
+    }
+    _mm_storeu_si128((__m128i *)r, y);
+    return true;
+}
+
+/*
+ * vcmpeqfp, vcmpgefp, vcmpgtfp (fv_cmp): all-ones or zero per lane; *all
+ * and *none as the helper accumulates them for CR6.
+ */
+static inline bool fv4_cmp(ppc_avr_t *r, const ppc_avr_t *a,
+                           const ppc_avr_t *b, int kind,
+                           uint32_t *all, uint32_t *none)
+{
+    __m128i ia = fv4_load(a), ib = fv4_load(b);
+    __m128 fa = _mm_castsi128_ps(ia), fb = _mm_castsi128_ps(ib);
+    __m128i y;
+    int m;
+
+    if (!fv4_all(_mm_and_si128(fv4_nz(ia), fv4_nz(ib)))) {
+        return false;
+    }
+    y = _mm_castps_si128(kind == 0 ? _mm_cmpeq_ps(fa, fb) :
+                         kind == 1 ? _mm_cmpge_ps(fa, fb) :
+                                     _mm_cmpgt_ps(fa, fb));
+    _mm_storeu_si128((__m128i *)r, y);
+    m = _mm_movemask_ps(_mm_castsi128_ps(y));
+    *all = m == 0xf ? (uint32_t)-1 : 0;
+    *none = m != 0 ? (uint32_t)-1 : 0;
+    return true;
+}
+
+/*
+ * vperm with SSSE3's byte shuffle (little-endian host: VsrB(i) is u8[15 - i]).
+ * Result byte u8[p] is byte (c.u8[p] & 0x1f) of a:b in big-endian
+ * numbering, i.e. a.u8[15 - k] or b.u8[15 - k] with k = c.u8[p] & 15.
+ */
+static bool fv_have_ssse3(void)
+{
+    static int have = -1;
+
+    if (unlikely(have < 0)) {
+        unsigned a, b, c, d;
+
+        have = __get_cpuid(1, &a, &b, &c, &d) && (c & bit_SSSE3);
+    }
+    return have;
+}
+
+static void __attribute__((target("ssse3")))
+fv_vperm_ssse3(ppc_avr_t *r, const ppc_avr_t *a, const ppc_avr_t *b,
+               const ppc_avr_t *c)
+{
+    __m128i va = fv4_load(a), vb = fv4_load(b), vc = fv4_load(c);
+    __m128i idx = _mm_andnot_si128(vc, _mm_set1_epi8(0x0f));
+    __m128i sel = _mm_cmpeq_epi8(_mm_and_si128(vc, _mm_set1_epi8(0x10)),
+                                 _mm_set1_epi8(0x10));
+    __m128i ra = _mm_shuffle_epi8(va, idx), rb = _mm_shuffle_epi8(vb, idx);
+
+    _mm_storeu_si128((__m128i *)r,
+                     _mm_or_si128(_mm_and_si128(sel, rb),
+                                  _mm_andnot_si128(sel, ra)));
+}
+#else
+#define FV_SIMD 0
+#endif
